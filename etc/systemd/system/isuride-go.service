[Unit]
Description=isuride-go
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
WorkingDirectory=/home/isucon/webapp/go
EnvironmentFile=/home/isucon/env.sh
Environment=PPROF=1
Environment=ISUCON_SOCKET=/run/isuride/app.sock
RuntimeDirectory=isuride
RuntimeDirectoryMode=0755
Environment=STATS=1
Environment=NEARBY_MAX_HOLD=4s
Environment=NEARBY_PER_CHAIR=8
# Environment=GOMAXPROCS=2

User=isucon
Group=isucon
ExecStart=/home/isucon/webapp/go/isuride
KillSignal=SIGTERM
TimeoutStopSec=60
LimitNOFILE=1000000

Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
