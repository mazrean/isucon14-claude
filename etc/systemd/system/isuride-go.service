[Unit]
Description=isuride-go
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
WorkingDirectory=/home/isucon/webapp/go
EnvironmentFile=/home/isucon/env.sh
Environment=PPROF=1
Environment=GOGC=400
Environment=PERSIST_INTERVAL=1s
# 実行中の書き込みはローカルの WAL のみ。起動時に WAL を MySQL へ流し込んでからロードする
Environment=PERSIST_MODE=wal
Environment=WAL_PATH=/home/isucon/isuride.wal
Environment=ISUCON_SOCKET=/run/isuride/app.sock
RuntimeDirectory=isuride
RuntimeDirectoryMode=0755
Environment=STATS=1
Environment=NEARBY_MAX_HOLD=8s
Environment=NEARBY_PER_CHAIR=32
# Environment=GOMAXPROCS=2

User=isucon
# TLS_ADDR=:443 (app ノードに nginx を置かないとき deploy.sh が drop-in で設定) のため
AmbientCapabilities=CAP_NET_BIND_SERVICE
Group=isucon
ExecStart=/home/isucon/webapp/go/isuride
KillSignal=SIGTERM
TimeoutStopSec=60
LimitNOFILE=1000000

Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
